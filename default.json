{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeMinor",
    ":semanticCommits",
    ":maintainLockFilesWeekly"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "prConcurrentLimit": 15,
  "prHourlyLimit": 0,
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "automerge": true,
    "schedule": ["* * * * 1"]
  },
  "packageRules": [
    {
      "description": "Auto-merge dev dependencies (they don't ship to users): npm, Composer, Bundler groups, Poetry/Cargo, uv/PDM",
      "matchDepTypes": [
        "devDependencies",
        "require-dev",
        "development",
        "test",
        "dev-dependencies",
        "tool.uv.dev-dependencies",
        "tool.pdm.dev-dependencies"
      ],
      "automerge": true
    },
    {
      "description": "Require review for major production-dependency bumps: npm/Poetry/Cargo, Composer, PEP 621",
      "matchDepTypes": ["dependencies", "require", "project.dependencies"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Hold TypeScript below 7: typescript-eslint 8 and astro check don't support TS 7 yet. Remove once they add TS 7 support.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Group non-major GitHub Actions updates into one PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group major GitHub Actions updates into one PR (usually just runtime bumps; still needs review)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "GitHub Actions (major)"
    },
    {
      "description": "Group astro and its official integrations so they move in lockstep. Security fixes stay separate: Renovate's vulnerabilityAlerts defaults force groupName null after packageRules.",
      "matchPackageNames": ["astro", "@astrojs/**"],
      "groupName": "astro"
    }
  ]
}
