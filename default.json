{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeAll",
    ":semanticCommits",
    ":maintainLockFilesWeekly"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "prConcurrentLimit": 15,
  "prHourlyLimit": 0,
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "automerge": true,
    "schedule": ["* * * * 1"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Hold TypeScript below 7: typescript-eslint 8 and astro check don't support TS 7 yet. Remove once they add TS 7 support.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Group non-major GitHub Actions updates into one PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group major GitHub Actions updates into one PR (usually just runtime bumps)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "GitHub Actions (major)"
    },
    {
      "description": "Group astro and its official integrations so they move in lockstep. Security fixes stay separate: Renovate's vulnerabilityAlerts defaults force groupName null after packageRules.",
      "matchPackageNames": ["astro", "@astrojs/**"],
      "groupName": "astro"
    }
  ]
}
